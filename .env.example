# Copy to .env (gitignored) and fill in. Never commit real keys.
# Google AI Studio key, used by LiteLLM for "gemini/..." models.
GEMINI_API_KEY=
# Optional, for open models later ("openrouter/..." models).
OPENROUTER_API_KEY=
# Optional, Weights & Biases.
WANDB_API_KEY=
# Self-hosted serving on Modal (configs/agent/modal_collect_*.yaml).
ATL_SERVING_URL=
ATL_SERVING_KEY=
